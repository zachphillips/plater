{
  "name": "@platercms/server-node",
  "version": "0.1.0",
  "description": "Drop-in Vercel/Node serverless handlers for Plater: config, content, save (GitHub-commit durable save with Google-or-token auth), plus feeds, sitemap, redirects/404, agent manifest, review state, and draft versions.",
  "type": "module",
  "exports": {
    "./config": "./config.js",
    "./content": "./content.js",
    "./save": "./save.js",
    "./upload": "./upload.js",
    "./agent-note": "./agent-note.js",
    "./review": "./review.js",
    "./publish": "./publish.js",
    "./propose-post": "./propose-post.js",
    "./feed": "./feed.js",
    "./sitemap": "./sitemap.js",
    "./route": "./route.js",
    "./manifest": "./manifest.js",
    "./versions": "./versions.js",
    "./history": "./history.js"
  },
  "files": [
    "config.js",
    "content.js",
    "save.js",
    "upload.js",
    "agent-note.js",
    "review.js",
    "publish.js",
    "propose-post.js",
    "feed.js",
    "sitemap.js",
    "route.js",
    "manifest.js",
    "versions.js",
    "history.js"
  ],
  "homepage": "https://zachphillips.github.io/plater/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachphillips/plater.git",
    "directory": "packages/server-node"
  },
  "bugs": {
    "url": "https://github.com/zachphillips/plater/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
