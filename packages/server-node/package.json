    "./review": "./review.js",
    "./publish": "./publish.js",
    "./propose-post": "./propose-post.js",
    "./feed": "./feed.js",
    "./sitemap": "./sitemap.js",
    "./route": "./route.js",
    "./manifest": "./manifest.js",
    "./versions": "./versions.js"
  },
  "files": [
    "config.js",
    "content.js",
    "save.js",
    "agent-note.js",
    "review.js",
    "publish.js",
    "propose-post.js",
