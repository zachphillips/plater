# Copy to .env for local notes, but set the real values on your host — never
# commit secrets. `npx platercms doctor .` prints this same checklist.
# Editing fails closed: with no CMS_ADMIN_EMAIL and no CMS_EDIT_TOKEN, nobody
# can save. `npx platercms dev .` needs none of these.

# --- who is allowed to edit (set at least one) ---
CMS_ADMIN_EMAIL=you@example.com          # the one Google account allowed to save
CMS_EDIT_TOKEN=                          # shared edit token, phone/iPad path; `openssl rand -hex 32`
GOOGLE_CLIENT_ID=                        # Google SSO client id; optional, gates editability when set

# --- where saves land (a real git commit) ---
GITHUB_TOKEN=                            # fine-grained PAT, contents:write on this repo only
GITHUB_REPOSITORY=you/your-site          # owner/repo the CMS commits to
GITHUB_BRANCH=main                       # commit branch
GITHUB_EDIT_PATH=content/site.json       # content file, relative to the repo root

# --- how the site describes itself ---
CMS_SITE_NAME=your-site                  # short name used in commit messages and forced onto agent notes
CMS_SITE_URL=https://example.com         # absolute origin; feeds and sitemap need it (falls back to meta.url)

# --- click-to-note agent routing (optional; leave blank to disable) ---
PLATER_AGENT_ENDPOINT=                   # agent host URL that runs Claude/Codex against a checkout
PLATER_AGENT_TOKEN=                      # bearer shared with the agent host; server-side only

# --- page enumeration + review state (optional) ---
PLATER_WEB_ROOT=.                        # static web root for sitemap/manifest page walking
PLATER_REVIEW_PATH=.plater-review.json   # per-page review state file
PLATER_REVIEW_WEBHOOK=                   # POSTed once every page is marked reviewed
